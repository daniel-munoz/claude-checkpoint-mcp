{
  "name": "session-checkpoint-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.daniel-munoz/claude-checkpoint-mcp",
  "description": "MCP server that checkpoints Claude Code session context to survive crashes and token limits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-munoz/claude-checkpoint-mcp.git"
  },
  "homepage": "https://github.com/daniel-munoz/claude-checkpoint-mcp#readme",
  "bugs": {
    "url": "https://github.com/daniel-munoz/claude-checkpoint-mcp/issues"
  },
  "author": "Daniel Munoz",
  "type": "module",
  "bin": {
    "session-checkpoint-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts src/hook.ts guard=src/guard-hook.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist && chmod +x dist/index.js dist/hook.js dist/guard.js && mkdir -p plugin/dist && cp dist/index.js dist/hook.js dist/guard.js plugin/dist/",
    "dev": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "checkpoint",
    "context"
  ],
  "license": "MIT"
}
